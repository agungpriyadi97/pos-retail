datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CASHIER
  ADMIN_OWNER
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
  DEBIT
}

enum ShrinkageReason {
  DAMAGED
  EXPIRED
  STOLEN
}

enum ShrinkageStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockMutationType {
  SALE
  RESTOCK
  TRANSFER_IN
  TRANSFER_OUT
  SHRINKAGE
  ADJUSTMENT
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  fullName     String
  passwordHash String
  role         Role     @default(CASHIER)
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions         Transaction[]
  shrinkageSubmissions ShrinkageLog[] @relation("SubmittedBy")
  shrinkageApprovals   ShrinkageLog[] @relation("ApprovedBy")

  @@index([role])
}

model Branch {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  address     String?
  phone       String?
  isWarehouse Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  stocks       BranchStock[]
  transactions Transaction[]
  shrinkages   ShrinkageLog[]
  stockLedgers StockLedger[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id            String   @id @default(cuid())
  barcode       String   @unique
  sku           String   @unique
  name          String
  description   String?
  costPrice     Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal  @db.Decimal(12, 2)
  minStockAlert Int      @default(5)
  unit          String   @default("PCS")
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stocks           BranchStock[]
  transactionItems TransactionItem[]
  shrinkageLogs    ShrinkageLog[]
  stockLedgers     StockLedger[]

  @@index([barcode])
  @@index([sku])
  @@index([name])
}

model BranchStock {
  id        String   @id @default(cuid())
  branchId  String
  productId String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

model Member {
  id         String   @id @default(cuid())
  phone      String   @unique
  fullName   String
  points     Int      @default(0)
  totalSpend Decimal  @default(0.00) @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transactions Transaction[]

  @@index([phone])
}

model Transaction {
  id             String        @id @default(cuid())
  invoiceNo      String        @unique
  branchId       String
  cashierId      String
  memberId       String?
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(12, 2)
  pointsUsed     Int           @default(0)
  pointDiscount  Decimal       @default(0.00) @db.Decimal(12, 2)
  finalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @db.Decimal(12, 2)
  changeAmount   Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @default(CASH)
  pointsEarned   Int           @default(0)
  createdAt      DateTime      @default(now())

  branch  Branch            @relation(fields: [branchId], references: [id])
  cashier User              @relation(fields: [cashierId], references: [id])
  member  Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  items   TransactionItem[]

  @@index([invoiceNo])
  @@index([branchId, createdAt])
}

model TransactionItem {
  id            String  @id @default(cuid())
  transactionId String
  productId     String
  quantity      Int
  costPrice     Decimal @db.Decimal(12, 2)
  sellingPrice  Decimal @db.Decimal(12, 2)
  subtotal      Decimal @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([transactionId])
  @@index([productId])
}

model ShrinkageLog {
  id            String          @id @default(cuid())
  branchId      String
  productId     String
  quantity      Int
  unitCost      Decimal         @db.Decimal(12, 2)
  totalLoss     Decimal         @db.Decimal(12, 2)
  reason        ShrinkageReason
  status        ShrinkageStatus @default(PENDING)
  notes         String
  batchNumber   String?
  expiredDate   DateTime?
  submittedById String
  approvedById  String?
  createdAt     DateTime        @default(now())
  resolvedAt    DateTime?

  branch      Branch  @relation(fields: [branchId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
  submittedBy User    @relation("SubmittedBy", fields: [submittedById], references: [id])
  approvedBy  User?   @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@index([status])
  @@index([branchId, createdAt])
}

model StockLedger {
  id             String            @id @default(cuid())
  branchId       String
  productId      String
  mutationType   StockMutationType
  quantityChange Int
  balanceAfter   Int
  referenceId    String?
  description    String?
  createdAt      DateTime          @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([branchId, productId, createdAt])
}

model StoreSetting {
  id                  String   @id @default("default_setting")
  storeName           String   @default("Sekar POS Retail")
  pointsEarnThreshold Decimal  @default(10000.00) @db.Decimal(12, 2)
  pointRedeemValue    Decimal  @default(100.00) @db.Decimal(12, 2)
  isLoyaltyActive     Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

